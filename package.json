{
  "name": "pendo-validate-install-extension",
  "version": "1.9.0",
  "author": "John Bambury <john.bambury@pendo.io> (Pendo Professional Services)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:agent": "node scripts/build-agent.mjs",
    "build:agent:refresh": "node scripts/build-agent.mjs --refresh",
    "check:agent": "vitest run tests/pendoAgentBundle.test.js",
    "build": "npm run build:agent && node scripts/build.mjs all",
    "build:chrome": "npm run build:agent && node scripts/build.mjs chrome",
    "build:firefox": "npm run build:agent && node scripts/build.mjs firefox"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@pendo/web-sdk": "2.341.0"
  }
}
