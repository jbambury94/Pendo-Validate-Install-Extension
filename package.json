{
  "name": "pendo-validate-install-extension",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:ext": "web-ext lint --source-dir extension",
    "start:firefox": "web-ext run --source-dir extension",
    "build:firefox": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "sign:firefox": "web-ext sign --source-dir extension --artifacts-dir dist --channel unlisted"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.0",
    "web-ext": "^10.3.0"
  }
}
